<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GridVids.ViewModels"
        xmlns:controls="using:GridVids.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="GridVids.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app-icon.png"
        Title="GridVids"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Width="1500">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="NumericUpDown /template/ TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="NumericUpDown:disabled">
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
        <Style Selector="NumericUpDown:disabled /template/ TextBox">
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Styles>

    <Grid Name="RootGrid" RowDefinitions="Auto,Auto,*">
        <!-- Video Grid -->
        <ItemsControl Grid.Row="2" Name="GridContainer" ItemsSource="{Binding VideoSlots}" IsVisible="{Binding IsGridVisible}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="{Binding Rows}" Columns="{Binding Columns}"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Styles>
                <Style Selector="ContentPresenter" x:DataType="vm:VideoSlotViewModel">
                    <Setter Property="IsVisible" Value="{Binding IsEffectiveVisible}"/>
                </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Background="Transparent" Margin="0">
                        <controls:NativeEmbeddingControl 
                            x:Name="Embedder"
                            HWnd="{Binding WindowHandle, Mode=OneWayToSource}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <Popup IsOpen="{Binding ShowMetadataOverlay}" Placement="TopEdgeAlignedRight" PlacementTarget="{Binding #Embedder}" IsLightDismissEnabled="False" Topmost="True" VerticalOffset="100">
                            <Border Background="#A0000000" Margin="10" Padding="10" CornerRadius="5">
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding FrameRate, StringFormat='Frame Rate: {0}'}" Foreground="LightGray" FontSize="12"/>
                                    <TextBlock Text="{Binding BitRate, StringFormat='Bit Rate: {0}'}" Foreground="LightGray" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Stack Overlay View -->
        <ItemsControl Grid.Row="2" Name="StackContainer" ItemsSource="{Binding StackSlots}" IsVisible="{Binding IsStackableEnabled}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas Background="Transparent"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Styles>
                <Style Selector="ContentPresenter" x:DataType="vm:VideoSlotViewModel">
                    <Setter Property="Canvas.Left" Value="{Binding EffectiveX}"/>
                    <Setter Property="Canvas.Top" Value="{Binding EffectiveY}"/>
                    <Setter Property="Width" Value="{Binding EffectiveWidth}"/>
                    <Setter Property="Height" Value="{Binding EffectiveHeight}"/>
                    <Setter Property="Opacity" Value="{Binding Opacity}"/>
                    <Setter Property="IsVisible" Value="{Binding IsEffectiveVisible}"/>
                </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Background="Transparent" Margin="0">
                        <controls:NativeEmbeddingControl 
                            x:Name="StackEmbedder"
                            HWnd="{Binding WindowHandle, Mode=OneWayToSource}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <Popup IsOpen="{Binding ShowMetadataOverlay}" Placement="TopEdgeAlignedRight" PlacementTarget="{Binding #StackEmbedder}" IsLightDismissEnabled="False" Topmost="True" VerticalOffset="100">
                            <Border Background="#A0000000" Margin="10" Padding="10" CornerRadius="5">
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding FrameRate, StringFormat='Frame Rate: {0}'}" Foreground="LightGray" FontSize="12"/>
                                    <TextBlock Text="{Binding BitRate, StringFormat='Bit Rate: {0}'}" Foreground="LightGray" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Scroll View -->
        <ItemsControl Grid.Row="2" Name="ScrollContainer" ItemsSource="{Binding ScrollSlots}" IsVisible="{Binding IsScrollEnabled}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas Background="Transparent" ClipToBounds="True"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Styles>
                <Style Selector="ContentPresenter" x:DataType="vm:VideoSlotViewModel">
                    <Setter Property="Canvas.Left" Value="{Binding EffectiveX}"/>
                    <Setter Property="Canvas.Top" Value="{Binding EffectiveY}"/>
                    <Setter Property="Width" Value="{Binding EffectiveWidth}"/>
                    <Setter Property="Height" Value="{Binding EffectiveHeight}"/>
                    <Setter Property="Opacity" Value="{Binding Opacity}"/>
                    <Setter Property="IsVisible" Value="{Binding IsEffectiveVisible}"/>
                </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Background="Black" Margin="0">
                        <controls:NativeEmbeddingControl 
                            x:Name="ScrollEmbedder"
                            HWnd="{Binding WindowHandle, Mode=OneWayToSource}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <Popup IsOpen="{Binding ShowMetadataOverlay}" Placement="TopEdgeAlignedRight" PlacementTarget="{Binding #ScrollEmbedder}" IsLightDismissEnabled="False" Topmost="True" VerticalOffset="100">
                            <Border Background="#A0000000" Margin="10" Padding="10" CornerRadius="5">
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding FrameRate, StringFormat='Frame Rate: {0}'}" Foreground="LightGray" FontSize="12"/>
                                    <TextBlock Text="{Binding BitRate, StringFormat='Bit Rate: {0}'}" Foreground="LightGray" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>



        <!-- Custom Title Bar -->
        <Grid Grid.Row="0" Height="32" Background="#1a1a1a" IsVisible="{Binding IsTitleBarVisible}" ColumnDefinitions="*,Auto" Name="TitleBar" ZIndex="1000">
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                       Foreground="#e0e0e0" VerticalAlignment="Center" Margin="12,0" FontSize="13" FontWeight="SemiBold"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="–" Width="46" VerticalAlignment="Stretch" Background="Transparent" Foreground="#ffffff" Name="BtnMinimize" BorderThickness="0"/>
                <Button Content="☐" Width="46" VerticalAlignment="Stretch" Background="Transparent" Foreground="#ffffff" Name="BtnMaximize" BorderThickness="0"/>
                <Button Content="✕" Width="46" VerticalAlignment="Stretch" Background="Transparent" Foreground="#ffffff" Name="BtnClose" BorderThickness="0"/>
            </StackPanel>
        </Grid>

        <!-- Control Bar -->
        <Border Grid.Row="1" Background="#181818" BorderBrush="#2d2d2d" BorderThickness="0,0,0,1" IsVisible="{Binding IsControlBarVisible}" ZIndex="1000" Name="ControlBar" Padding="8,6">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <!-- Group 1: Media & Layout -->
                <Border Background="#242426" BorderBrush="#38383a" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,2,8,2">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="📁 MEDIA &amp; LAYOUT" Foreground="#8e8e93" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Button Command="{Binding SelectVideoFolderCommand}" Content="Select Folder" Padding="8,4"/>
                        <Button Command="{Binding PlayCommand}" Content="Play" Padding="8,4" ToolTip.Tip="Restart playback"/>
                        <Button Command="{Binding StopCommand}" Content="Stop" Padding="8,4" ToolTip.Tip="Stop playback"/>
                        <TextBlock Text="{Binding VideoPath}" MaxWidth="140" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="#d1d1d6" ToolTip.Tip="{Binding VideoPath}"/>
                        <Rectangle Width="1" Height="16" Fill="#444446" Margin="2,0"/>
                        <TextBlock Text="Rows:" VerticalAlignment="Center" Foreground="#e5e5ea"/>
                        <NumericUpDown Value="{Binding Rows}" Minimum="1" Maximum="5" Width="90" FormatString="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="#ffffff" Padding="0"/>
                        <TextBlock Text="Cols:" VerticalAlignment="Center" Foreground="#e5e5ea"/>
                        <NumericUpDown Value="{Binding Columns}" Minimum="1" Maximum="8" Width="90" FormatString="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="#ffffff" Padding="0"/>
                    </StackPanel>
                </Border>

                <!-- Group 2: Display Mode -->
                <Border Background="#242426" BorderBrush="#38383a" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,2,8,2">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="🎬 DISPLAY MODE" Foreground="#8e8e93" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox ItemsSource="{Binding DisplayModeOptions}" SelectedItem="{Binding SelectedDisplayMode}" Width="135" Padding="6,4"/>
                        <CheckBox Content="Cycle" IsChecked="{Binding IsCycleModesEnabled}" VerticalAlignment="Center"/>
                        <TextBlock Text="Delay:" VerticalAlignment="Center" IsEnabled="{Binding IsCycleModesEnabled}" Foreground="#e5e5ea"/>
                        <ComboBox ItemsSource="{Binding CycleDelayOptions}" SelectedItem="{Binding SelectedCycleDelay}" Width="65" IsEnabled="{Binding IsCycleModesEnabled}"/>
                        <!-- Contextual Auto-Swap Controls -->
                        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsSwapEnabled}" VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding GridSizeOptions}" SelectedItem="{Binding SelectedGrid1}" Width="70"/>
                            <TextBlock Text="↔" VerticalAlignment="Center" Foreground="#aaaaaa"/>
                            <ComboBox ItemsSource="{Binding GridSizeOptions}" SelectedItem="{Binding SelectedGrid2}" Width="70"/>
                        </StackPanel>
                        <!-- Contextual Scroll Speed Controls -->
                        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsScrollEnabled}" VerticalAlignment="Center">
                            <Rectangle Width="1" Height="16" Fill="#444446" Margin="2,0"/>
                            <TextBlock Text="Speed:" VerticalAlignment="Center" Foreground="#e5e5ea"/>
                            <Slider Value="{Binding ScrollSpeed}" Minimum="20" Maximum="300" Width="90" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ScrollSpeed, StringFormat='{}{0:0}'}" Width="26" FontSize="11" VerticalAlignment="Center" Foreground="#cccccc"/>
                            <Rectangle Width="1" Height="16" Fill="#444446" Margin="2,0"/>
                            <ToggleSwitch IsChecked="{Binding IsScrollDown}" OffContent="Up" OnContent="Down" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Group 3: Randomize & Timing -->
                <Border Background="#242426" BorderBrush="#38383a" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,2,8,2">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="⚡ RANDOMIZE &amp; TIMING" Foreground="#8e8e93" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <CheckBox Content="Random Swap" IsChecked="{Binding IsRandomSwapEnabled}" VerticalAlignment="Center"/>
                        <TextBlock Text="Randomize Delay:" VerticalAlignment="Center" IsEnabled="{Binding IsDelayEnabled}" Foreground="#e5e5ea"/>
                        <ComboBox ItemsSource="{Binding DelayOptions}" SelectedItem="{Binding SelectedDelay}" Width="65" IsEnabled="{Binding IsDelayEnabled}"/>
                    </StackPanel>
                </Border>

                <!-- Group 4: Audio & Playback Options -->
                <Border Background="#242426" BorderBrush="#38383a" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,2,8,2">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="🔊 OPTIONS" Foreground="#8e8e93" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <CheckBox Content="Mute" IsChecked="{Binding IsMuted}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding !IsMuted}" VerticalAlignment="Center">
                            <TextBlock Text="Vol:" VerticalAlignment="Center" Foreground="#e5e5ea"/>
                            <Slider Value="{Binding Volume}" Minimum="0" Maximum="100" Width="75" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Volume, StringFormat='{}{0}%'}" Width="30" FontSize="11" VerticalAlignment="Center" Foreground="#cccccc"/>
                        </StackPanel>
                        <Rectangle Width="1" Height="16" Fill="#444446" Margin="2,0"/>
                        <CheckBox Content="Single Vid" IsChecked="{Binding IsSingleVidEnabled}" VerticalAlignment="Center"/>
                        <CheckBox Content="Random Start" IsChecked="{Binding IsRandomStartEnabled}" VerticalAlignment="Center"/>
                        <CheckBox Content="Slo-mo" IsChecked="{Binding IsSloMoEnabled}" VerticalAlignment="Center"/>
                        <CheckBox Content="Auto-Hide" IsChecked="{Binding IsAutoHideEnabled}" VerticalAlignment="Center"/>
                        <Rectangle Width="1" Height="16" Fill="#444446" Margin="2,0"/>
                        <CheckBox Content="Debug" IsChecked="{Binding IsDebugEnabled}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#38bdf8"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </Border>

        <!-- Middle Debug Information HUD (Popup with Topmost="True" to render over native video player HWNDs) -->
        <Popup x:Name="DebugPopup"
               IsOpen="{Binding IsDebugEnabled}"
               PlacementTarget="{Binding #RootGrid}"
               Placement="Center"
               VerticalOffset="0"
               HorizontalOffset="0"
               Topmost="True"
               IsLightDismissEnabled="False"
               Focusable="False">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#F012141C"
                    BorderBrush="#4438bdf8"
                    BorderThickness="1.5"
                    CornerRadius="10"
                    Padding="16,10"
                    BoxShadow="0 8 24 0 #80000000">
                <StackPanel Orientation="Vertical" Spacing="6" HorizontalAlignment="Center">
                    <!-- Header / Display Mode Line -->
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Border Background="#2038bdf8" BorderBrush="#38bdf8" BorderThickness="1" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="DEBUG INFO" Foreground="#38bdf8" FontSize="11" FontWeight="Bold" LetterSpacing="0.5"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <TextBlock Text="Mode:" Foreground="#9ca3af" FontSize="12" FontWeight="Medium"/>
                            <TextBlock Text="{Binding SelectedDisplayMode}" Foreground="#f8fafc" FontSize="14" FontWeight="ExtraBold"/>
                        </StackPanel>
                        <TextBlock Text="|" Foreground="#4b5563" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <TextBlock Text="Slots:" Foreground="#9ca3af" FontSize="12"/>
                            <TextBlock Text="{Binding DebugActiveSlotsCount}" Foreground="#34d399" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="|" Foreground="#4b5563" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <TextBlock Text="Recycled Pool:" Foreground="#9ca3af" FontSize="12"/>
                            <TextBlock Text="{Binding DebugRecycledBatchCount}" Foreground="#fbbf24" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Detailed Settings & Diagnostics Line -->
                    <TextBlock Text="{Binding DebugModeDetails}"
                               Foreground="#cbd5e1"
                               FontSize="11"
                               FontWeight="Normal"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
